@model DevConnect.Models.TbUsuario

<link rel="stylesheet" href="~/css/Usuario.css">
<script defer>
    const usuarioNovoCadastro = "@ViewBag.UsuarioNovoCadastro";
    if (usuarioNovoCadastro) == "Nao cadastrado") {
        alert("Usuário já cadastrado. Por favor, tente novamente com outro e-mail ou nome de usuário.");
    }
</script>

<main>
    <div>

        <form id="formulario" class="estilo-formulario" enctype="multipart/form-data" asp-action="Index"
            asp-controller="Usuario">

            <img src="../images/logo-devconnect-lg.svg" alt="Logo DevConnect">
            <p class="subtexto">Cadastre-se para comunidade exclusiva de desenvolvedores(as).</p>

            <div class="formularioDiv">

                <div>
                    <input type="text" id="nome" placeholder="Nome e sobrenome" required asp-for="NomeCompleto" />
                </div>

                <div>
                    <input type="text" id="usuario" placeholder="Nome de usuário" required asp-for="NomeUsuario" />
                </div>

                <div>
                    <input type="email" id="email" placeholder="E-mail" required asp-for="Email" />
                </div>
                <div>
                    <input type="password" id="senha" placeholder="Senha" required asp-for="Senha" />
                </div>

            </div>

            <div class="upload-imagem">
                <label for="upload" class="upload-label">
                    Faça upload da sua imagem aqui...
                </label>
                <input type="file" id="upload" class="upload-input" name="imagem" />
            </div>

            <button class="formulario-botao-azul" type="submit">Cadastrar-se</button>

            <p class="texto-cadastrar">
                Ao se cadastrar, você concorda com nossos<br>
                Termos, Política de Dados e Política de Cookies.
            </p>

        </form>

        <section id="secao-login" class="secao-cadastro">
            <p>Tem uma conta? <a href="../pages/index.html">Conecte-se</a></p>
        </section>
    </div>
</main>