                </a>
            </article>
            <article class="card-storys">
                <a href="#">
                    <img src="../images/img.nathan.jpg" alt="">
                    <span>ruyter</span>
                </a>
            </article>
            <article class="card-storys">
                <a href="#">
                    <img src="../images/img.nathan.jpg" alt="">
                    <span>ruyter</span>
                </a>
            </article>
            <article class="card-storys">
                <a href="#">
                    <img src="../images/img.nathan.jpg" alt="">
                    <span>ruyter</span>
                </a>
            </article>
            <article class="card-storys">
                <a href="#">
                    <img src="../images/img.nathan.jpg" alt="">
                    <span>ruyter</span>
                </a>
            </article>
            <article class="card-storys">
                <a href="#">
                    <img src="../images/img.nathan.jpg" alt="">
                    <span>ruyter</span>
                </a>
            </article>
            <article class="card-storys">
                <a href="#">
                    <img src="../images/img.nathan.jpg" alt="">
                    <span>ruyter</span>
                </a>
            </article>
        </section>
        <!-- Fim Stories -->


        <section id="cadastro-publi">
            <h2>Publicação</h2>
            <form asp-action="Index" asp-controller="Feed" method="post" enctype="multipart/form-data">
                <textarea name="Descricao" placeholder="Digite a descrição do post..." required></textarea>

                <footer>
                    <div>
                        <label for="arquivo" class="botao-upload">Faça o upload da sua imagem</label>
                        <input type="file" id="arquivo" name="imagem">
                    </div>
                    <button type="submit" class="formulario-botao-azul">Postar</button>
                </footer>

            </form>
        </section>

        <!-- Publicações -->
        <section id="Publicacao">
            @foreach (TbPublicacao publi in Model)
            {
                if (!publi.ImagemUrl.IsNullOrEmpty())
                {
                    <article class="card-publi">
                        <header class="publi-header">
                            <a href="#">
                                <img class="foto-de-perfil" src="~/images/@publi.IdUsuarioNavigation?.FotoPerfilUrl" 
                                alt="Foto de perfil">
                                @publi.IdUsuarioNavigation?.NomeUsuario
                                <span class="nome-usuario">wesley</span>
                                <span class="tempo-publicado">• 1 d</span>
                            </a>
                        </header>
                        <figure>
                            <img class="imagem-publicacao" src="~/images/@publi.ImagemUrl" alt="Paisagem">
                        </figure>

                        <div class="interacoes-publicacao">
                            <img src="../images/icone-coracao-preto.svg" alt="Curtir">
                            <img src="../images/icone-comentario-preto.svg" alt="Comentar">
                        </div>

                        <span class="likes">1M curtidas</span>

                        <div class="description-publicacao">
                            <strong>Wesley</strong>
                            <p>Vcs estão bem?</p>
                        </div>

                        <button class="ver-comentarios">Ver todos os comentários...</button>
                    </article>

                }
                else
                {
                    <article class="post">
                        <div class="post-header">
                            <img src="../images/img.nathan.jpg" alt="Foto Wesley" />
                            <div class="nome-post">
                                Wesley

                            </div>
                        </div>
                        <p class="texto">
                            Esta é a história não contada de um caçador, que um dia foi para a floresta para fazer exatamente
                            isso,
                            caçar.
                            Em sua viagem, ele decidiu mudar de rumo para dar diversidade ao seu ofício, então ele virou seu
                            caminhão e
                            o estacionou em
                            frente a uma área de floresta desconhecida que tinha a
                        </p>
                        <div class="post-like">
                            <div class="like" title="Curtir">
                                1M curtidas
                            </div>
                            <div class="post-comentario">Ver todos os comentários...</div>
                        </div>
                    </article>
                }




            }
        </section>

    </div>
</main>