        <!-- Fim Stories -->

        <!-- Formulário de Publicação -->
        <section id="cadastro-publi" class="estilo-formulario">
            <h2>Publicação</h2>

            <form action="">
                <textarea placeholder="Digite a descrição do post..."></textarea>
                <footer>
                    <label for="upload" class="texto-upload">Faça upload da sua imagem aqui...</label>
                    <input type="file" id="upload" class="upload-input" />
                    <button type="submit" class="formulario-botao-azul">Postar</button>
                </footer>
            </form>
        </section>

        <!-- Publicações -->
        <section id="Publicacao">
            <article class="card-publi">
                <header class="publi-header">
                    <a href="#">
                        <img class="foto-de-perfil" src="../images/img.nathan.jpg" alt="Foto de perfil">
                        <span class="nome-usuario">wesley</span>
                        <span class="tempo-publicado">• 1 d</span>
                    </a>
                </header>

                <figure>
                    <img class="imagem-publicacao" src="../images/img paisagem post.jpg" alt="Paisagem">
                </figure>

                <div class="interacoes-publicacao">
                    <img src="../images/icone-coracao-preto.svg" alt="Curtir">
                    <img src="../images/icone-comentario-preto.svg" alt="Comentar">
                </div>

                <span class="likes">1M curtidas</span>

                <div class="description-publicacao">
                    <strong>Wesley</strong>
                    <p>Vcs estão bem?</p>
                </div>

                <button class="ver-comentarios">Ver todos os comentários...</button>
            </article>
        </section>

    </div>
</main>