@using Microsoft.IdentityModel.Tokens
@model List<DevConnect.Models.TbPublicacao>

<script>
    const publicacaoCadastrado = "@ViewBag.PublicacaoCadastrado";
    if (publicacaoCadastrado === "Sucesso") {
        alert("Publicação cadastrada com sucesso!");
    }
    else if (publicacaoCadastrado == "Não cadastrada") {
        alert("Erro ao cadastrar a publicação. Por favor, tente novamente.");
    }
    else if (publicacaoCadastrado === "Cadastrada") {
        alert("Publicação postada com sucesso!");
    }
</script>




<link rel="stylesheet" href="~/css/feed.css">

<header id="cabeçalho">
    <nav>
        <a id="Logo-desktop" href="./feed.html">
            <img src="../images/logo-devconnect-lg.svg" alt="Logo da Empresa DevConnect">
        </a>

        <a id="Logo-mobile" href="./feed.html">
            <img src="../images/logo-devconnect-sm.svg" alt="Logo da Empresa DevConnect">
        </a>

        <div class="cabeçalho-acoes">

            <a asp-controller="Feed" asp-action="Index">
                <img src="../images/icone-casa-azul.svg" alt="icone de uma casa azul">
            </a>

            <a href="#"><img src="../images/icone-coracao-azul.svg" alt="icone de um coração azul"></a>

            <a asp-controller="Usuario" asp-action="Perfil">
                <img class="foto-de-perfil" src="../images/img.nathan.jpg" alt="Foto de perfil">
            </a>
        </div>
    </nav>
</header>

<main>
    <div class="container-flex-publi">

        <!-- Stories -->
        <section id="storys" class="estilo-formulario">

            <!-- Exemplo de story -->
            <article class="card-storys">
                <a href="#">
                    <img src="../images/img.nathan.jpg" alt="">
