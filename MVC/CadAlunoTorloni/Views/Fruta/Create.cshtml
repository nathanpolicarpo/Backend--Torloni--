@* Importa a model da fruta *@
@model CadAlunoTorloni.Models.Fruta

<h1>Cadastro de frutas</h1>

@* criar o formulario de cadastro de fruta  *@
<form action="Create" method="post">

<label >Nome</label>
<input  asp-for="Nome" class="form-control"/>

<br>
<label >Cor</label>
<input  asp-for="Cor" class="form-control"/>

<br>
<label >Categoria</label>
<input  asp-for="Categoria" class="form-control"/>


<br>
<br>
<button class="btn btn-success">Salvar</button>
<button type="reset" class="btn btn-danger">Voltar</button>

</form>
